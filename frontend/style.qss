/* Global font and background */
QMainWindow {
    background-color: #ecf0f1;
    font-family: "Segoe UI";
    font-size: 12pt;
}

/* Tabs */
QTabBar::tab {
    background: #bdc3c7;
    padding: 8px;
    margin: 2px;
    border-radius: 4px;
    color: #2c3e50;
}
QTabBar::tab:selected {
    background: #3498db;
    color: white;
}

/* Tables */
QTableWidget {
    background-color: #f9f9f9;
    gridline-color: #cccccc;
    font-size: 11pt;
}
QHeaderView::section {
    background-color: #2c3e50;
    color: white;
    padding: 6px;
    border: 1px solid #34495e;
}
QTableWidget::item {
    padding: 4px;
}

/* Text areas (Reports) */
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    padding: 8px;
    font-size: 11pt;
    color: #2c3e50;
}
